pipeline{
    agent any

    environment{
        IMAGE_NAME = 'mkdockerpractices/my-ci-cd-app'
        SERVER_IP = 'ubuntu@3.94.214.236'
    }

    stages{
        stage("Checkout code"){
            steps{
                echo "Checking out code from repository...."  
            }
        }

        

        stage("Build docker image"){
            steps{
               
                 script{
                    echo "Building docker image..."
                    withCredentials([usernamePassword(credentialsId:'dockerHub', passwordVariable:'PASSWORD', usernameVariable:'USERNAME')]){
                        sh "docker build -t ${IMAGE_NAME} ."
                        sh '''
                            echo "$PASSWORD" | docker login -u "$USERNAME" --password-stdin
                        '''
                        sh "docker push ${IMAGE_NAME}"
                    }
                }
            }   
        }

       
        stage("Deploy to AWS"){
            steps{
        script{
            echo "Deploying docker image to AWS..."
            def dockerCmd = "sudo docker-compose -f docker-compose.yaml up --detach"
            sshagent(['ec2-server']) {
 sh '''
    set -e
    mkdir -p ~/.ssh
    chmod 700 ~/.ssh
    HOST="${SERVER_IP#*@}"
    ssh-keyscan -H "$HOST" >> ~/.ssh/known_hosts
    chmod 600 ~/.ssh/known_hosts

    scp -o StrictHostKeyChecking=yes docker-compose.yaml ${SERVER_IP}:/home/ubuntu/
    ssh -o StrictHostKeyChecking=yes ${SERVER_IP} '${dockerCmd}'
  '''
}
        } 
    }    
}
    }

    post{
        
        success{
            echo "The pipline succesfuly depoyed the app to AWS"
        }
        failure{
            echo "The pipline failed to deploy the app to AWS!"
        }
    }
}
