pipeline{
    agent any

    environment{
        IMAGE_NAME = 'mkdockerpractices/my-ci-cd-app'
        SERVER_IP = 'ubuntu@3.94.214.236'
    }

    stages{
        stage("Checkout code"){
            steps{
                echo "Checking out code from repository...."  
            }
        }

        

        stage("Build docker image"){
            steps{
               
                 script{
                    echo "Building docker image..."
                    withCredentials([usernamePassword(credentialsId:'dockerHub', passwordVariable:'PASSWORD', usernameVariable:'USERNAME')]){
                        sh "docker build -t ${IMAGE_NAME} ."
                        sh '''
                            echo "$PASSWORD" | docker login -u "$USERNAME" --password-stdin
                        '''
                        sh "docker push ${IMAGE_NAME}"
                    }
                }
            }   
        }


stages {
    stage("Deploy to AWS") {
      steps {
        script {
          echo "Deploying docker image to AWS..."

          sshagent(['ec2-server-key']) {
            sh """
              set -euxo pipefail

              mkdir -p ~/.ssh
              ssh-keyscan -H ${SERVER_IP.split('@')[1]} >> ~/.ssh/known_hosts

              scp docker-compose.yaml ${SERVER_IP}:/home/ubuntu/docker-compose.yaml

              ssh -o StrictHostKeyChecking=no ${SERVER_IP} '
                set -euxo pipefail
                cd /home/ubuntu

                sudo -n docker version

                if sudo -n docker compose version >/dev/null 2>&1; then
                  COMPOSE="sudo -n docker compose"
                elif command -v docker-compose >/dev/null 2>&1; then
                  COMPOSE="sudo -n docker-compose"
                else
                  echo "ERROR: Neither docker compose nor docker-compose is installed"
                  exit 1
                fi

                $COMPOSE -f docker-compose.yaml up -d
                $COMPOSE -f docker-compose.yaml ps
              '
            """
          }
        }
      }
    }
  }

  post {
    success {
      echo "The pipeline successfully deployed the app to AWS"
    }
    failure {
      echo "The pipeline failed to deploy the app to AWS!"
    }
  }
}
